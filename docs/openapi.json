        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRestaurant"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": false,
            "description": "Required whenever a session cookie is present. Read from zayqora_csrf cookie; value is signed and session-bound.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128,
              "pattern": "^[a-zA-Z0-9_-]+$"
            },
            "description": "User-scoped retry key; same key with changed payload returns IDEMPOTENCY_CONFLICT."
          }
        ]
      },
