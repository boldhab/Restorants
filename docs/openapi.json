    "/restaurants": {
      "post": {
        "summary": "Create private restaurant, initial branch and owner atomically",
        "description": "Verified email required. Transaction includes role, audit and idempotency response. Begins in onboarding state.",
        "operationId": "post__restaurants",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
