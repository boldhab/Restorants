{
  "openapi": "3.1.0",
  "info": {
    "title": "ZAYQORA Phase 1",
    "version": "1.0.0",
    "description": "Same-origin session API. Every private response uses no-store. Errors have stable codes and request IDs. Local memory email capture is excluded from production."
  },
