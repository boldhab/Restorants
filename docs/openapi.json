        "additionalProperties": false,
        "required": [
          "id",
          "email",
          "full_name",
          "is_email_verified"
        ]
      },
      "Membership": {
        "type": "object",
        "properties": {
          "restaurant_id": {
            "type": "string",
            "format": "uuid"
          },
          "restaurant_name": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
