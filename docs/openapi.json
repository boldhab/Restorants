    "/auth/register": {
      "post": {
        "summary": "Register an unprivileged unverified user",
        "description": "Email normalized to trimmed lowercase. Extra privilege fields are rejected. Sends verification email; never returns its token.",
        "operationId": "post__auth_register",
        "security": [],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "$ref": "#/components/schemas/User"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Register"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": false,
            "description": "Required whenever a session cookie is present. Read from zayqora_csrf cookie; value is signed and session-bound.",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Authenticate and rotate the presented session",
        "description": "Sets HttpOnly session cookie and readable CSRF cookie. Invalid credentials use one generic 401 message.",
        "operationId": "post__auth_login",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "$ref": "#/components/schemas/User"
                    },
                    "memberships": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Membership"
                      }
                    },
                    "csrfToken": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
