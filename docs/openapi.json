    "/auth/me": {
      "get": {
        "summary": "Safe current user and active memberships",
        "description": "Returns authenticated=false with null user for missing, expired, or revoked sessions. Refreshes CSRF cookie when authenticated.",
        "operationId": "get__auth_me",
        "security": [],
