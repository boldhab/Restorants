{
  "name": "@zayqora/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "test": "NODE_ENV=test tsx --test --test-concurrency=1 tests/unit/*.test.ts tests/integration/*.test.ts tests/security/*.test.ts",
    "test:unit": "NODE_ENV=test tsx --test tests/unit/*.test.ts",
    "test:integration": "NODE_ENV=test tsx --test --test-concurrency=1 tests/integration/*.test.ts"
  },
  "dependencies": {
    "@zayqora/contracts": "*",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^10.6.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0"
  }
}
