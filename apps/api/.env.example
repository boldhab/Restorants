NODE_ENV=development
PORT=4000
# Local development credentials only. Replace for any hosted environment.
DATABASE_URL=postgres://postgres:1234@127.0.0.1:5432/zayqora_dev
PGSSL=false
ALLOWED_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000
SESSION_SECRET=development-session-secret-change-in-production
COOKIE_SECRET=development-cookie-secret-change-in-production
SESSION_TTL_HOURS=168
COOKIE_NAME=zayqora_sid
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY_HOPS=0
# memory: local-only /api/v1/dev/emails capture. smtp: Mailpit or production SMTP.
EMAIL_PROVIDER=memory
EMAIL_FROM=ZAYQORA <no-reply@zayqora.local>
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Phase 2 media: private delivery through the publication-aware API.
MEDIA_STORAGE=local
# Use a persistent, non-source, non-executable volume outside /tmp in production.
MEDIA_LOCAL_ROOT=/tmp/zayqora-media
# Set MEDIA_STORAGE=s3 to use private S3-compatible object storage (path-style SigV4).
MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
